# Exact actor -> configured code; unit affiliation must also be ACTIVE in Alfresco gdo.
# Synthetic example: {"person@example.invalid":{"unitId":"00000000-0000-4000-8000-000000000099","documentCode":"DTI-UNIT-AA","signatoryCode":"AA"}}
# Heads use the verified unit code, without signatoryCode. No write gates are enabled here.
ALFRESCO_DOCUMENT_ISSUER_ASSIGNMENTS_JSON={}

# Alfresco hierarchy service (keep the password in local secrets, never commit it)
ALFRESCO_HIERARCHY_SERVICE_USERNAME=
ALFRESCO_HIERARCHY_SERVICE_PASSWORD=
