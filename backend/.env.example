# Office inbox folders in the authorized Alfresco DEV repository.
# Keep these IDs in the backend environment, never in VITE_* variables.
ALFRESCO_OFFICE_INBOX_NODE_IDS_JSON='{"DTI":{"emitidos":"NODE_ID_DTI_EMITIDOS","porAtender":"NODE_ID_DTI_POR_ATENDER","porConocimiento":"NODE_ID_DTI_POR_CONOCIMIENTO"},"DSA":{"emitidos":"NODE_ID_DSA_EMITIDOS","porAtender":"NODE_ID_DSA_POR_ATENDER","porConocimiento":"NODE_ID_DSA_POR_CONOCIMIENTO"}}'
# Alfresco dependency group IDs granted read access to cross-office multi-filed PDFs.
ALFRESCO_OFFICE_GROUP_IDS_JSON='{"DTI":"GROUP_GD_DTI","DSA":"GROUP_GD_DSA"}'
# Optional: personal inboxes for non-director recipient workflows.
ALFRESCO_USER_INBOX_NODE_IDS_JSON='{"ALFRESCO_USER_ID":"NODE_ID_PERSONAL_INBOX"}'
